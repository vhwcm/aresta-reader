{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Aresta Reader",
  "version": "1.0.0",
  "identifier": "com.aresta.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3010",
    "beforeBuildCommand": "npm run generate",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "Aresta Reader — Leitor Digital & Retenção de Conhecimento",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb"],
    "icon": [
      "../public/favicon-32x32.png",
      "../public/icon-192.png",
      "../public/icon-512.png",
      "../public/logo_aresta.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:aresta-reader.db"]
    }
  }
}
